# SKEWNONO backend environment — TEMPLATE (tracked in git).
#
# Copy this file to `.env` in the SAME folder, then fill in real values:
#     cp back_dev_home/.env.example back_dev_home/.env
#
# `.env` itself is gitignored, so home and office keep separate local copies.
# The app factory loads back_dev_home/.env at startup (load_dotenv).
# Format rules: no quotes, no `export`, no spaces around `=`.

# ── Chat feature ────────────────────────────────────────────────────
# Home: OpenRouter key. Office: internal LLM gateway key (see chat/MIGRATION.md).
CHAT_API_KEY=replace-with-your-key
# JSON array of selectable models. Defaults go stale — set explicitly.
CHAT_MODELS=[{"id":"openai/gpt-oss-20b:free","label":"GPT-OSS 20B (free)"}]

# ── Redis (office only) ─────────────────────────────────────────────
# Office adapters that read Redis connect with these. Leave unset at home.
#   sem_list : parquet keys `v3_df_sem_avail` + `v3_df_sem_version`
#   storage  : parquet keys `v3_df_ppid_storage_{cdsem,hvsem}`
#              + hash `v3_hitachi_sem_ppid_not_avail`
#   health / api_tokens : probe + token store
# REDIS_HOST=replace-with-office-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=replace-with-office-redis-password

# ── OpenSearch (office only) ────────────────────────────────────────
# Office adapters that read OpenSearch connect with these (via ops_store,
# which reads the OPENSEARCH_* vars). Leave unset at home.
#   recipe_tat : aliases `meas_hist_cdsem` / `meas_hist_hvsem` (the
#                foundational measurement-history DB behind the TAT and
#                other analysis dashboards). Aggregations only.
# Port defaults to 443 (HTTPS); the office cluster uses SSL with self-signed
# certs, so verify_certs stays off unless you point OPENSEARCH_CA_CERTS at a CA.
# OPENSEARCH_HOST=replace-with-office-opensearch-host
# OPENSEARCH_PORT=443
# OPENSEARCH_USER=replace-with-office-opensearch-user
# OPENSEARCH_PASSWORD=replace-with-office-opensearch-password
# OPENSEARCH_USE_SSL=true
# OPENSEARCH_VERIFY_CERTS=false

# ── MinIO — NOT configured here ─────────────────────────────────────
# MinIO settings live in `minio_handler/minio_config.py` (gitignored), which
# is the single source of truth: endpoint, access key, secret key, secure,
# region, cert_check, plus the default bucket ("user") and prefix
# ("2067928/"). Used by the health probe and the msr_file image/file features.
#
# DO NOT add MINIO_* lines to .env. `minio_handler/base.py` gives env vars
# HIGHER precedence than minio_config.py, so any MINIO_* line here silently
# overrides the file you actually maintain — and an empty one is the worst
# case: `MINIO_SECRET_KEY=` reads as "" which is not None, so it resolves to
# None and wipes out a perfectly good SECRET_KEY with no error pointing back
# at .env. Keeping this section credential-free is what makes
# minio_config.py's values authoritative.
#
# At home nothing is reachable regardless (the endpoint is an office-network
# name that does not resolve); the health check traps the failure and shows a
# visible `mock · ` fallback, so app startup never breaks.

# ── Data provider switch (home <-> office) ──────────────────────────
# A feature serves office data when TWO things are true:
#
#   1. the process is in OFFICE MODE, and
#   2. that feature has a providers/office.py file.
#
# Neither one is configured here. Office mode is auto-detected
# (back_dev_home/_runtime/site.py): the Phase 3 cloud deploy path
# (/project/workSpace) and hostnames starting with "PC" (company office-PC
# naming) are office; the home Mac mini and unknown hosts are home. And a
# feature becomes office-ready the moment you run
#
#   cp back_dev_home/<feature>/providers/office_example.py \
#      back_dev_home/<feature>/providers/office.py
#
# and restart Flask. office.py is gitignored, so it only ever exists where
# someone deliberately created it — which is why its presence alone is
# trusted. Features without one stay on mock, silently and safely, so a
# half-migrated office machine never 500s its unwired pages.
#
# To see what is actually live right now: GET /api/health/providers, or read
# the provider table Flask logs at startup. Nothing in .env records it.
#
# Site override (rarely needed — e.g. testing an office adapter from home
# over VPN; you must also cp the office.py you want to exercise):
# SKEWNONO_SITE=office
# Extra office hostnames, only for office machines NOT named PC<...>
# (comma-separated, compared lowercase without domain suffix):
# SKEWNONO_OFFICE_HOSTNAMES=office-mac-01
#
# Mode override. `office` forces office MODE (the filesystem still decides
# per feature); `mock` is a whole-instance kill switch that returns every
# page to mock without deleting any adapter:
# SKEWNONO_DATA_PROVIDER=mock
#
# Per-feature override, to pin ONE feature against the mode. The key is the
# same one its data.py passes to get_data_provider("<key>"):
#   =mock    forces mock even though office.py exists — the escape hatch when
#            an adapter breaks mid-shift.
#   =office  is only legal when that feature's office.py exists. Otherwise
#            Flask REFUSES TO START and prints the cp command: an explicit
#            request for real fab data is never silently answered with mock.
# SKEWNONO_STORAGE_PROVIDER=mock
# SKEWNONO_SEM_LIST_PROVIDER=office
#
# Which features are PROVEN against real 사내 data (as opposed to merely
# having an office.py) lives in exactly one place: the 상태/검증일 columns of
# docs/office-migration/STATUS.md.
#
# hardware switches per TAB as well as per feature. Its dispatcher lazily
# imports providers/<tab>/office.py and falls back to that tab's mock.py when
# the file is absent, so hardware can be office-ready while individual tabs
# are still mock. That fallback is NOT marked in the response — check
# `ls back_dev_home/ebeam/hitachi/hardware/providers/*/office.py` or the
# dispatcher's log line. A tab whose office.py exists but fails to import
# raises instead of falling back.
# ────────────────────────────────────────────────────────────────────

# ── live_alarm writer (runs on the scheduler service, not on SKEWNONO) ──
# The writer targets the SAME Redis the office adapters read, at db 0.
# office_redis.py passes no db, so the reader always sits on db 0 — set
# LIVE_ALARM_REDIS_DB to anything else and the writer and reader silently
# split onto different databases with no error from either side.
LIVE_ALARM_REDIS_HOST=
LIVE_ALARM_REDIS_PORT=6379
LIVE_ALARM_REDIS_PASSWORD=
LIVE_ALARM_REDIS_DB=0
LIVE_ALARM_PRUNE_SEC=900
LIVE_ALARM_HTTP_TIMEOUT=3,7
