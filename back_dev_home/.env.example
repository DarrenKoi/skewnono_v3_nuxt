# SKEWNONO backend environment — TEMPLATE (tracked in git).
#
# Copy this file to `.env` in the SAME folder, then fill in real values:
#     cp back_dev_home/.env.example back_dev_home/.env
#
# `.env` itself is gitignored, so home and office keep separate local copies.
# The app factory loads back_dev_home/.env at startup (load_dotenv).
# Format rules: no quotes, no `export`, no spaces around `=`.

# ── Flask session signing ───────────────────────────────────────────
# Signs the self-identification session, whose `verified` flag is only
# meaningful if the signature is. `__init__.py` falls back to a constant
# that is committed to this repository, so an unset key means the flag is
# forgeable by anyone who can read the source — with no error to notice.
#
# REQUIRED on the cloud: `is_cloud()` refuses to boot without it, which is
# how the deploy is forced to choose a value instead of inheriting the
# fallback silently. Home and office-localhost may leave it unset.
# Any non-empty string satisfies the check; pick one per environment.
SKEWNONO_SECRET_KEY=

# ── Reverse-proxy trust (cloud, and ONLY behind nginx) ──────────────
# ProxyFix for real client IPs (X-Forwarded-For, one hop). Two-sided trap,
# and BOTH directions fail silently (docs/deployment.md):
#   - set while uwsgi's http-socket is exposed directly → any caller forges
#     their address with a header, including the declared_from the self-id
#     session exists to capture;
#   - left unset after the app moves behind nginx → every request records
#     as 127.0.0.1, with no error from anything.
# Flip it in the SAME change that puts nginx in front — never before, never
# later. Truthy spellings: 1 / true / yes.
# SKEWNONO_TRUST_PROXY=true

# ── Chat feature ────────────────────────────────────────────────────
# Surface A of chat (LLM gateway) is env-only — the API key and model list
# live HERE, not in chat/providers/office_example.py (that file is thread
# STORAGE, Surface B). See chat/MIGRATION.md.
#
# Gateway base URL. The client appends /chat/completions. Unset -> OpenRouter
# (home default), which the egress guard BLOCKS in office mode — at the
# office you must set the internal OpenAI-compatible gateway explicitly:
# CHAT_BASE_URL=http://replace-with-internal-llm-gateway/v1
#
# Bearer token, sent as `Authorization: Bearer <key>`. Home: OpenRouter key.
# Office: internal gateway key. Unset -> no auth header.
CHAT_API_KEY=replace-with-your-key
#
# Runtime and provider selectors are independent. `agent` requires a model
# with supports_tools=true. Selecting an office provider never falls back to
# mock when its adapter or settings are unavailable; see chat/MIGRATION.md.
SKEWNONO_CHAT_RUNTIME=direct
SKEWNONO_CHAT_KNOWLEDGE_PROVIDER=mock
SKEWNONO_CHAT_SCOPE_PROVIDER=mock
# Approved source root. Keep actual source content and internal paths out of git.
SKEWNONO_RAG_SOURCE_ROOT=
# Server-side agent bounds.
SKEWNONO_CHAT_MAX_TOOL_CALLS=6
# Process-local concurrent agent workers. Values outside 1..32 are rejected.
SKEWNONO_CHAT_MAX_CONCURRENT_AGENT_RUNS=4
# Source snippets are truncated before tool/model use and API persistence.
SKEWNONO_CHAT_MAX_SNIPPET_CHARS=1200
# Aggregate model-facing evidence above this bound rejects the turn with 422.
SKEWNONO_CHAT_MAX_EVIDENCE_CHARS=12000
# Whole agent invocation deadline in seconds, including every model/tool round.
SKEWNONO_CHAT_AGENT_TIMEOUT=60
# Selectable models — JSON array on ONE line. "id" is sent verbatim as the
# request `model`; "label" is the picker text. Capability flags are required
# for office handoff. Replace the placeholders in the gitignored `.env`.
CHAT_MODELS=[{"id":"model-id","label":"Model label","supports_tools":false,"supports_vision":false}]
#
# Request timeout in seconds (default 60):
# CHAT_TIMEOUT=60

# ── Redis (office only) ─────────────────────────────────────────────
# Office adapters that read or write Redis connect with these. Unset at home.
#   sem_list : parquet keys `v3_df_sem_avail` + `v3_df_sem_version`   (read)
#   storage  : parquet keys `v3_df_ppid_storage_{cdsem,hvsem}`        (read)
#              + hash `v3_hitachi_sem_ppid_not_avail`
#   health   : connectivity probe                                    (read)
#   api_tokens : WRITES `skewnono:api_tokens:*` — the token store must be
#              shared, or bearer auth breaks across gunicorn workers
#   msr_image  : WRITES `skewnono:msr_image:*` — download-job state (TTL'd)
#   access_control : WRITES `skewnono:access_control:*` — X-id exception
#              grants + denied attempts. An outage 503s X-members' requests
#              by design; see access_control/MIGRATION.md's outage table.
#   announcements : reads `skewnono:announcements` (a JSON array). Set it to
#              publish a banner with no redeploy; every failure, INCLUDING
#              these vars being unset, degrades to "no banners", never a 500.
# REDIS_HOST=replace-with-office-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=replace-with-office-redis-password

# ── OpenSearch (office only) ────────────────────────────────────────
# Office adapters that read OpenSearch connect with these (via ops_store,
# which reads the OPENSEARCH_* vars). Leave unset at home.
#   recipe_tat : aliases `meas_hist_cdsem` / `meas_hist_hvsem` (the
#                foundational measurement-history DB behind the TAT and
#                other analysis dashboards). Aggregations only.
# Port defaults to 443 (HTTPS); the office cluster uses SSL with self-signed
# certs, so verify_certs stays off unless you point OPENSEARCH_CA_CERTS at a CA.
# OPENSEARCH_HOST=replace-with-office-opensearch-host
# OPENSEARCH_PORT=443
# OPENSEARCH_USER=replace-with-office-opensearch-user
# OPENSEARCH_PASSWORD=replace-with-office-opensearch-password
# OPENSEARCH_USE_SSL=true
# OPENSEARCH_VERIFY_CERTS=false
#
# Logging target is REQUIRED when OpenSearch logging or the activity/admin
# office adapters are enabled. It picks the alias BOTH the shipper writes and
# /admin-logs reads, so a wrong value is self-consistent: the app looks
# healthy while the other alias stays empty. Copying this file between the
# office PC and the cloud without changing this line is the way that happens
# (it did, on 2026-08-03) — preflight.py now fails the cloud deploy on `local`.
# Office PC localhost:
# SKEWNONO_LOG_ENV=local
# Company production cloud:
# SKEWNONO_LOG_ENV=production
# Emergency write kill switch; readers still report 503 if storage is down.
# OPENSEARCH_LOGGING_DISABLED=false

# ── MinIO — NOT configured here ─────────────────────────────────────
# MinIO settings live in `minio_handler/minio_config.py` (gitignored), which
# is the single source of truth: endpoint, access key, secret key, secure,
# region, cert_check, plus the default bucket ("user") and prefix
# ("2067928/"). Used by the health probe and the msr_file image/file features.
#
# DO NOT add MINIO_* lines to .env. `minio_handler/base.py` gives env vars
# HIGHER precedence than minio_config.py, so any MINIO_* line here silently
# overrides the file you actually maintain — and an empty one is the worst
# case: `MINIO_SECRET_KEY=` reads as "" which is not None, so it resolves to
# None and wipes out a perfectly good SECRET_KEY with no error pointing back
# at .env. Keeping this section credential-free is what makes
# minio_config.py's values authoritative.
#
# At home nothing is reachable regardless (the endpoint is an office-network
# name that does not resolve); the health check traps the failure and shows a
# visible `mock · ` fallback, so app startup never breaks.

# ── Data provider switch (home <-> office) ──────────────────────────
# A feature serves office data when TWO things are true:
#
#   1. the process is in OFFICE MODE, and
#   2. that feature has a providers/office.py file.
#
# Neither one is configured here. Office mode is auto-detected
# (back_dev_home/_runtime/site.py): the Phase 3 cloud deploy path
# (/project/workSpace) and hostnames starting with "PC" (company office-PC
# naming) are office; the home Mac mini and unknown hosts are home. And a
# feature becomes office-ready the moment you run
#
#   cp back_dev_home/<feature>/providers/office_example.py \
#      back_dev_home/<feature>/providers/office.py
#
# and restart Flask. office.py is gitignored, so it only ever exists where
# someone deliberately created it — which is why its presence alone is
# trusted. Features without one stay on mock, silently and safely, so a
# half-migrated office machine never 500s its unwired pages.
#
# To see what is actually live right now: GET /api/health/providers, or read
# the provider table Flask logs at startup. Nothing in .env records it.
#
# Site override (rarely needed — e.g. testing an office adapter from home
# over VPN; you must also cp the office.py you want to exercise):
# SKEWNONO_SITE=office
# Extra office hostnames, only for office machines NOT named PC<...>
# (comma-separated, compared lowercase without domain suffix):
# SKEWNONO_OFFICE_HOSTNAMES=office-mac-01
#
# Mode override. `office` forces office MODE (the filesystem still decides
# per feature); `mock` is a whole-instance kill switch that returns every
# page to mock without deleting any adapter:
# SKEWNONO_DATA_PROVIDER=mock
#
# Per-feature override, to pin ONE feature against the mode. The key is the
# same one its data.py passes to get_data_provider("<key>"):
#   =mock    forces mock even though office.py exists — the escape hatch when
#            an adapter breaks mid-shift.
#   =office  is only legal when that feature's office.py exists. Otherwise
#            Flask REFUSES TO START and prints the cp command: an explicit
#            request for real fab data is never silently answered with mock.
# SKEWNONO_STORAGE_PROVIDER=mock
# SKEWNONO_SEM_LIST_PROVIDER=office
#
# Which features are PROVEN against real 사내 data (as opposed to merely
# having an office.py) lives in exactly one place: the 상태/검증일 columns of
# docs/office-migration/STATUS.md.
#
# hardware switches per TAB as well as per feature. Its dispatcher lazily
# imports providers/<tab>/office.py and falls back to that tab's mock.py when
# the file is absent, so hardware can be office-ready while individual tabs
# are still mock. That fallback is NOT marked in the response — check
# `ls back_dev_home/ebeam/hitachi/hardware/providers/*/office.py` or the
# dispatcher's log line. A tab whose office.py exists but fails to import
# raises instead of falling back.
# ────────────────────────────────────────────────────────────────────

# ── live_alarm ───────────────────────────────────────────────────────
# No variables. The board is refreshed by the request that reads it, over
# the shared REDIS_* connection above, and its cache/lock TTLs are
# constants in live_alarm/contracts.py rather than env knobs.
#
# This block used to configure a separate scheduler writer with its own
# LIVE_ALARM_REDIS_* connection, where setting LIVE_ALARM_REDIS_DB to
# anything but 0 silently split the writer and reader onto different
# databases. Writer and reader are the same process now, so that failure
# has no way to occur.
# ────────────────────────────────────────────────────────────────────

# ── msr_image (SEM 이미지 tool FTP fetch + 공유 캐시) ──────────────────
# The gallery relays SEM micrographs from the measuring tool's FTP server
# through Flask, caching them (disk at home, shared MinIO at the office).
# Home stays fully mock (SVG); office swaps to the ftp_handler adapter once
# back_dev_home/msr_image/providers/office.py exists. See msr_image/MIGRATION.md.
#
# Provider select follows the standard rule — no pin needed: office MODE +
# providers/office.py present ⇒ office. Uncomment only as the escape hatch
# to force mock while an adapter is broken mid-shift:
# SKEWNONO_MSR_IMAGE_PROVIDER=mock
#
# Tool FTP credentials — all Hitachi tools share hitachi/hid (사내 관례, 비기밀).
# The frontend sends each tool's eqp_ip; the backend validates it (IPv4, and
# the optional subnet allowlist below) before opening a session.
SKEWNONO_TOOL_FTP_USER=hitachi
SKEWNONO_TOOL_FTP_PASSWORD=hid
SKEWNONO_TOOL_FTP_PORT=21
SKEWNONO_TOOL_FTP_TIMEOUT=8
# Bounded concurrent connections to ONE tool for the "전체 다운로드" job.
# Keep small — Hitachi tool FTP servers cap simultaneous sessions.
SKEWNONO_TOOL_FTP_CONCURRENCY=6
# Optional SSRF guard: comma-separated CIDRs the tool IP must fall inside.
# Empty = IPv4-format validation only.
SKEWNONO_TOOL_SUBNETS=
#
# Cache — home writes to a local dir; office writes to a shared MinIO prefix.
IMAGE_CACHE_DIR=var/image_cache
# The MinIO cache client runs as a PASSTHROUGH (no client-side prefix), so
# SKEWNONO_IMAGE_CACHE_PREFIX is the SOLE prefix. If the office requires objects
# under a user namespace, set the FULL prefix (e.g. user/2067928/image_cache/).
# Keep it separate from the measurement-data buckets/prefixes.
SKEWNONO_IMAGE_CACHE_BUCKET=
SKEWNONO_IMAGE_CACHE_PREFIX=image_cache/
# Cache retention (3 days) + nightly purge hour (local). The office also runs
# an Airflow DAG (minio_purge_image_cache, 03:35 KST) over the same prefix with
# the same 3-day window, as a safety net for when this app is down. Keep the
# two windows equal -- a shorter one here makes the DAG a permanent no-op.
# Both were moved 7d -> 3d together on 2026-08-02 (user-confirmed); if you
# change one, change flask_modules' RETENTION_DAYS in the same breath.
IMAGE_CACHE_TTL_HOURS=72
IMAGE_CACHE_PURGE_HOUR=3
# Download-all job runner: concurrent jobs + job-state TTL (seconds). Office
# multi-worker keeps job state in Redis (REDIS_* above); home uses process memory.
SKEWNONO_MSR_IMAGE_MAX_JOBS=2
SKEWNONO_MSR_IMAGE_JOB_TTL=3600

# ── Scheduler ────────────────────────────────────────────────────
# Set to 0/false/no/off to stop the scheduler starting at all. The test
# suite sets this (back_dev_home/conftest.py) -- without it, a suite run
# between 01:00 and 08:00 fires the real jobs. Unset means enabled.
# SKEWNONO_SCHEDULER_ENABLED=1
# Orphan-clear window for the job lock, in seconds. NOT a runtime budget --
# a live run re-arms its own TTL.
# SKEWNONO_SCHEDULER_LOCK_TTL=600
# How many job-run records to retain.
# SKEWNONO_SCHEDULER_LOG_MAX=500
# Weekly device-statistics snapshots: where home writes them, and how many
# weeks to keep. The requirement is six months of history, so 26.
# SKEWNONO_WEEKLY_TREND_DIR=var/weekly_trend
# SKEWNONO_WEEKLY_TREND_KEEP_WEEKS=26
