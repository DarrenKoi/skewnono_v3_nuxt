# SKEWNONO backend environment — TEMPLATE (tracked in git).
#
# Copy this file to `.env` in the SAME folder, then fill in real values:
#     cp back_dev_home/.env.example back_dev_home/.env
#
# `.env` itself is gitignored, so home and office keep separate local copies.
# The app factory loads back_dev_home/.env at startup (load_dotenv).
# Format rules: no quotes, no `export`, no spaces around `=`.

# ── Chat feature ────────────────────────────────────────────────────
# Home: OpenRouter key. Office: internal LLM gateway key (see chat/MIGRATION.md).
CHAT_API_KEY=replace-with-your-key
# JSON array of selectable models. Defaults go stale — set explicitly.
CHAT_MODELS=[{"id":"openai/gpt-oss-20b:free","label":"GPT-OSS 20B (free)"}]

# ── Redis (office only) ─────────────────────────────────────────────
# Office adapters that read Redis connect with these. Leave unset at home.
#   sem_list : parquet keys `v3_df_sem_avail` + `v3_df_sem_version`
#   storage  : parquet keys `v3_df_ppid_storage_{cdsem,hvsem}`
#              + hash `v3_hitachi_sem_ppid_not_avail`
#   health / api_tokens : probe + token store
# REDIS_HOST=replace-with-office-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=replace-with-office-redis-password

# ── OpenSearch (office only) ────────────────────────────────────────
# Office adapters that read OpenSearch connect with these (via ops_store,
# which reads the OPENSEARCH_* vars). Leave unset at home.
#   recipe_tat : aliases `meas_hist_cdsem` / `meas_hist_hvsem` (the
#                foundational measurement-history DB behind the TAT and
#                other analysis dashboards). Aggregations only.
# Port defaults to 443 (HTTPS); the office cluster uses SSL with self-signed
# certs, so verify_certs stays off unless you point OPENSEARCH_CA_CERTS at a CA.
# OPENSEARCH_HOST=replace-with-office-opensearch-host
# OPENSEARCH_PORT=443
# OPENSEARCH_USER=replace-with-office-opensearch-user
# OPENSEARCH_PASSWORD=replace-with-office-opensearch-password
# OPENSEARCH_USE_SSL=true
# OPENSEARCH_VERIFY_CERTS=false

# ── MinIO (office only) ─────────────────────────────────────────────
# The health check probes MinIO (stat the latest object referenced by the
# OpenSearch latest doc's `minio_path`); msr_file image/file features use it
# too. Read by `minio_handler`. Leave unset at home — the health check catches
# the missing config and falls back to a visible `mock · ` value, so app
# startup never breaks; set these at the office to enable the live probe.
# Default bucket ("user") and prefix ("2067928/") come from
# minio_handler/minio_config.py — no env var needed for those.
# MINIO_ENDPOINT=aistor-api.lake.skhynix.com   # host, no scheme
# MINIO_ACCESS_KEY=usermade-2067928
# SECRET NEVER goes in this tracked file — set MINIO_SECRET_KEY only in the
# gitignored back_dev_home/.env.
# MINIO_SECRET_KEY=replace-with-office-minio-secret-key
# MINIO_SECURE=true         # false if the endpoint is plain http
# MINIO_REGION=
# MINIO_CERT_CHECK=false     # true to verify TLS certs

# ── Data provider switch (home <-> office) ──────────────────────────
# Each feature reads providers/office.py when set to `office`, else
# providers/mock.py. Values: mock | office. Unset = mock (home-safe default).
#
# HOME: leave everything unset/commented -> all features use mock.
# OFFICE: after you `cp office_example.py office.py` and implement a feature,
#         uncomment its line (or the master switch) to serve real data.
#
# Master switch — flips ALL features at once:
# SKEWNONO_DATA_PROVIDER=office
#
# Per-feature overrides (win over the master switch). Prefer these over the
# master switch while opening the office step by step — an unimplemented
# feature left on mock can't break startup. One line per feature whose data.py
# calls get_data_provider("<key>") — all 20 are listed.
#
# Opened so far (office-ready) — uncomment each as it goes live:
# SKEWNONO_HEALTH_PROVIDER=office       # re-exports the live Redis/OpenSearch/MinIO probes
# SKEWNONO_SEM_LIST_PROVIDER=office
# SKEWNONO_RECIPE_TAT_PROVIDER=office   # OpenSearch meas_hist_{cdsem,hvsem} + ebeam_tas_lot_hist + Redis device_desc/r3_device_grp
# SKEWNONO_STORAGE_PROVIDER=office      # needs SEM_LIST=office too (ppid join)
#
# Remaining top-level features (still mock):
# SKEWNONO_ACCESS_CONTROL_PROVIDER=office
# SKEWNONO_ACTIVITY_PROVIDER=office
# SKEWNONO_ADMIN_LOGS_PROVIDER=office
# SKEWNONO_AFM_PROVIDER=office
# SKEWNONO_ANNOUNCEMENTS_PROVIDER=office
# SKEWNONO_API_TOKENS_PROVIDER=office
# SKEWNONO_CHAT_PROVIDER=office
# SKEWNONO_MEAS_HIST_PROVIDER=office
# SKEWNONO_MSR_FILE_PROVIDER=office
#
# Remaining e-beam tool features (back_dev_home/ebeam/..., still mock):
# SKEWNONO_DEVICE_STATISTICS_PROVIDER=office
# SKEWNONO_FAIL_ISSUE_PROVIDER=office
# SKEWNONO_HARDWARE_PROVIDER=office
# SKEWNONO_LATERAL_RECIPE_PROVIDER=office
# SKEWNONO_PM_PLANNING_PROVIDER=office
# SKEWNONO_RECIPE_SEARCH_PROVIDER=office
# SKEWNONO_SKEW_PROVIDER=office
# ────────────────────────────────────────────────────────────────────
