# Office data adapters (Phase 2/3): created per-environment by copying
# providers/office_example.py -> providers/office.py, then implemented at the
# office. Never tracked, so `git pull` at the office can never conflict on it.
# `**` covers nested provider folders too (e.g. ebeam/hardware/providers/fdc/).
# The second pattern covers per-tab adapters (e.g. hardware/providers/fdc/office.py).
back_dev_home/**/providers/office.py
back_dev_home/**/providers/**/office.py
# live_alarm's writer has a second swap surface OUTSIDE providers/ — its
# office.py holds the in-house alarm API URLs and must never be tracked.
back_dev_home/**/writer/office.py
# `scripts.sync_office_adapters --force` writes office.py.bak beside the
# adapter before overwriting it. That backup holds the same 사내 details as the
# adapter, so an untracked one at the office is a `git add -A` away from being
# committed. Ignore it wherever office.py itself is ignored.
back_dev_home/**/providers/office.py.bak
back_dev_home/**/providers/**/office.py.bak
back_dev_home/**/writer/office.py.bak

# msr_image office FTP cache dir + explicit office adapter (already matched by
# the glob above; listed explicitly for clarity on this feature).
var/
back_dev_home/msr_image/providers/office.py

# The office chat RAG is a separate 사내 git repository checked out INSIDE this
# tree at back_dev_home/chat/_rag/ (see back_dev_home/chat/rag.py). Its own
# .git keeps working there; this repo must never track it — it carries manual
# content, a built index and 사내 model endpoints. The leading underscore keeps
# the app factory, the office registry and the deploy pack from walking it.
back_dev_home/chat/_rag/

# scripts/probe_recipe_ftp.py dumps the .idp files it pulls off tool FTP here.
# Real recipe payloads -- never committed.
.ftp-probe/

# `office_utils` is an 사내 package that exists ONLY on office machines; the
# recipe_search adapter imports it to parse .idp recipe files. At home a
# fabricated stand-in of the same name sits here so that adapter can be written
# and run -- and it must NEVER be tracked, in either direction:
#   pushed  -> it would shadow the real package at the office and serve
#              fabricated recipe data from production, at HTTP 200.
#   pulled  -> a tracked copy would carry 사내 parser details out of the office.
# Same rule, same reason, as providers/office.py above.
# No trailing slash on purpose: a dir-only pattern would stop matching the
# moment office_utils is a symlink to a copy kept outside the worktree (git
# classifies a symlink as a file), and the link would surface as untracked.
/office_utils

# Playwright test runner artifacts (the MCP session dumps live in .playwright-mcp/).
# No leading slash, so this matches at any depth -- front-dev-home/test-results/
# and any future workspace's included.
test-results/

# Vendor/publisher PDFs dropped under docs/research/ for reference. This repo is
# PUBLIC so the office can pull it anonymously, and the papers we read (e.g. the
# SPIE Kawada 2009 CD-matching paper) are paywalled — cite them by DOI in the
# Markdown instead of redistributing the file.
docs/research/*.pdf
